# Copy to .env and edit. Never commit .env (it is listed in .gitignore).

# Database passwords: use long random strings (for example: openssl rand -base64 32)
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-moodle

# First Moodle administrator account (created on first boot only)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change-me-admin
MOODLE_ADMIN_EMAIL=idawoyemi@crimson.ua.edu
MOODLE_SITE_NAME=David Awoyemi Learning Studio

# Public hostname. For a local test use: localhost:8080  (site opens at http://localhost:8080,
# Moodle's own port; the Caddy proxy on 80/443 is for production only)
# For production use your domain, for example: learn.davidawoyemi.com
MOODLE_HOST=localhost:8080

# Address Caddy serves. Local trial: http://localhost  (plain HTTP, no certificate)
# Production: the bare domain, e.g. learn.davidawoyemi.com  (automatic HTTPS)
SITE_ADDRESS=http://localhost

# Set both to "yes" in production (HTTPS proxy in front of Moodle). Leave "no" for the local trial.
MOODLE_REVERSEPROXY=no
MOODLE_SSLPROXY=no
